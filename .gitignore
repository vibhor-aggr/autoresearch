# Python build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# pytest caches
.pytest_cache/

# Experiment outputs (large files – download from compute node as needed)
ideas/**/experiments/results/
ideas/**/experiments/figures/
ideas/**/experiments/data/

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Pipeline credential / secret configs (NEVER commit)
config/backends.yaml
config/secrets.yaml

# Pipeline state and generated outputs
ideas/**/pipeline_state.json
ideas/**/experiments/results/
ideas/**/experiments/figures/
ideas/**/experiments/data/
ideas/**/paper/*.pdf
ideas/**/paper/*.aux
ideas/**/paper/*.bbl
ideas/**/paper/*.blg

# Temporary stub-run idea directories (slug "tbd" means the idea name wasn't yet resolved)
ideas/idea-*-tbd/

# Environment files
.env
*.env
